                # ✅ Marquer cette notification comme traitée
                st.session_state["last_s7_processed"] = notification

                # ✅ AUTO-FILL SESSION STATE
                # Pre-select LRU (will trigger reset on next render)
                st.session_state["s7_autofill_lru"] = result["lru_pn"]


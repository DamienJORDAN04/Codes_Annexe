        if st.session_state.get("last_s7_processed") != notification:
            with st.spinner("🔎 Searching S7 database..."):
                result = autofill_from_s7(notification)

            if result["success"]:
                # Display success message
                st.success(f"✅ {result['message']}")

                # Display metadata in info box
                meta = result["metadata"]
                st.info(
                    f"**LRU:** {result['lru_display_name']} ({result['lru_pn']})\n\n"

                st.session_state["s7_autofill_cards"] = result["slot_configuration"]

                # Pre-fill metadata for display
                st.session_state["s7_autofill_metadata"] = meta

                # ✅ RERUN seulement si nécessaire (quand les autres widgets doivent se mettre à jour)
                st.rerun()
            else:
                st.error(f"❌ {result['message']}")

                # ✅ Show tried formats for debugging
                normalized = normalize_notification_number(notification)
                if normalized:
                    try:
                        num_int = int(normalized)

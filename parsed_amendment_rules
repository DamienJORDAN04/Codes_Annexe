"""
Intermediate Transform: Parsed Amendment Rules

Parses the Logic_JSON from amendment rules to create a structured, queryable dataset.
Explodes the JSON structure into individual slot requirements.
Handles both mandatory_slots and slot_groups structures.

v15.1: Added slot_name normalization (removes ALL spaces)
v16.0: Removed 'amendment', 'description', 'supersedes' fields — no longer present in Logic_JSON
       nor in source CSV columns (Description, Supersedes, Amdt_Name removed from source).
v16.1: Restored Amdt_Name, Warning_Text, Description, Supersedes columns from source.
       Added BAC slot support in mandatory_slots schema.
       Source changed from amendment_rules_source path to rules_amendments (with RID).
v16.1.1: Defensive column aliasing — handles both 'amdt_name' (new) and 'amendment_name' (legacy)
         so that parsed_amendment_rules builds even if rules_amendments is not yet rebuilt.

Input: /Airbus/EYY/Logic/Avionics/Support/Conf_Management/sources/rules_amendments
Output: /Airbus/EYY/Logic/Avionics/Support/Conf_Management/intermediate/parsed_amendment_rules
"""

from transforms.api import Input, Output, transform
from pyspark.sql import functions as F
from pyspark.sql.types import ArrayType, StructType, StructField, StringType


@transform(
    output=Output("/Airbus/EYY/Logic/Avionics/Support/Conf_Management/intermediate/parsed_amendment_rules"),
    rules=Input("/Airbus/EYY/Logic/Avionics/Support/Conf_Management/sources/rules_amendments"),
)
def compute(rules, output):
    """
    Parse Logic_JSON using native Spark with correct schema.

    Handles TWO structures:
    1. mandatory_slots (direct slot requirements, including BAC)
    2. slot_groups (grouped slots like CPU_COM/CPU_MON)

    v15.1 NORMALIZATION:
    - Removes ALL spaces from slot_name (e.g., "PSM _CARD" → "PSM_CARD")
    - Removes ALL spaces from group_name for consistency

    v16.1:
    - Source is now rules_amendments (which reads from the Foundry raw dataset RID).
    - amdt_name, warning_text, description, supersedes columns are now propagated.
    - BAC slot is supported as a mandatory_slot (sub-ensemble of WIRED_ASSY, only on FCPC).

    v16.1.1:
    - Defensive column aliasing: supports both 'amdt_name' (v16.1+) and
      'amendment_name' (legacy v15/v16.0) so the transform never fails due to
      stale upstream schema.

    This transform converts the hierarchical JSON structure into a flat table
    where each row represents a slot requirement for a specific rule.
    """

    df = rules.dataframe()

    # ==========================================
    # DEFENSIVE: normalise 'amendment_name' → 'amdt_name' if needed
    # The rules_amendments source may still expose the old column name if it
    # hasn't been rebuilt yet after the v16.1 rename.
    # ==========================================
    existing_cols = df.columns
    if "amdt_name" not in existing_cols and "amendment_name" in existing_cols:
        df = df.withColumnRenamed("amendment_name", "amdt_name")

    # Also add any missing optional columns as NULL so downstream selects are safe
    for col_name in ("amdt_name", "warning_text", "description", "supersedes"):
        if col_name not in df.columns:
            df = df.withColumn(col_name, F.lit(None).cast(StringType()))

    # Select only the columns we need (normalised names)
    df = df.select(
        F.col("unit"),
        F.col("rule_id"),
        F.col("target_lru_pn"),
        F.col("logic_json"),
        F.col("amdt_name"),
        F.col("warning_text"),
        F.col("description"),
        F.col("supersedes"),
    )

    # Add computed columns for supersedes and priority
    df = df.withColumn(
        "supersedes_raw",
        F.when(F.col("supersedes").isNull(), F.lit("[]"))
        .when(F.col("supersedes") == "", F.lit("[]"))
        .when(F.col("supersedes") == "[]", F.lit("[]"))
        .otherwise(F.col("supersedes")),
    )

    df = df.withColumn(
        "supersedes_count",
        F.when(F.col("supersedes_raw") == "[]", F.lit(0)).otherwise(F.size(F.split(F.col("supersedes"), ","))),
    )

    # Generic amendment priority — no hardcoded letter list.
    # Rules:
    #   "STD"                  → 0
    #   Single letter (A-Z)    → ascii(letter) - 64  (A=1, B=2, … Z=26)
    #   Multi-char (AA, AB, …) → 100 + ascii(first_char) - 64
    #                            e.g. "AA"→101, "AB"→102, "BA"→102 …
    # This ensures any future amendment letter sorts correctly without code changes.
    df = df.withColumn(
        "amendment_priority",
        F.when(F.col("amdt_name") == "STD", F.lit(0))
        .when(
            F.length(F.col("amdt_name")) == 1,
            F.ascii(F.col("amdt_name")) - F.lit(64),  # A=1, B=2, …, Z=26
        )
        .otherwise(F.lit(100) + F.ascii(F.substring(F.col("amdt_name"), 1, 1)) - F.lit(64)),
    )

    # Define complete JSON schema matching your actual data
    json_schema = StructType(
        [
            StructField(
                "rules",
                ArrayType(
                    StructType(
                        [
                            StructField("comment", StringType(), True),
                            StructField(
                                "context_check",
                                StructType(
                                    [
                                        StructField("part_type", StringType(), True),
                                        StructField("pn", StringType(), True),
                                    ]
                                ),
                                True,
                            ),
                            StructField(
                                "mandatory_slots",
                                ArrayType(
                                    StructType(
                                        [
                                            StructField("slot_name", StringType(), True),
                                            StructField(
                                                "allowed_pns",
                                                ArrayType(StringType()),
                                                True,
                                            ),
                                        ]
                                    )
                                ),
                                True,
                            ),
                            StructField(
                                "slot_groups",
                                ArrayType(
                                    StructType(
                                        [
                                            StructField("group_name", StringType(), True),
                                            StructField(
                                                "slots_included",
                                                ArrayType(StringType()),
                                                True,
                                            ),
                                            StructField(
                                                "allowed_pns",
                                                ArrayType(StringType()),
                                                True,
                                            ),
                                            StructField("mix_policy", StringType(), True),
                                        ]
                                    )
                                ),
                                True,
                            ),
                        ]
                    )
                ),
                True,
            ),
        ]
    )

    # Parse JSON
    df = df.withColumn("parsed_json", F.from_json(F.col("logic_json"), json_schema))

    # Explode rules array
    df = df.withColumn("rule", F.explode(F.col("parsed_json.rules")))

    # ==========================================
    # PART 1: Handle mandatory_slots
    # Includes: WIRED_ASSY, BMC, BLC, BAC (sub-ensemble of WIRED_ASSY, FCPC only)
    # ==========================================
    df_mandatory = df.filter(F.col("rule.mandatory_slots").isNotNull())

    if df_mandatory.count() > 0:
        df_mandatory = df_mandatory.withColumn("slot", F.explode(F.col("rule.mandatory_slots")))

        df_mandatory = df_mandatory.select(
            "unit",
            "rule_id",
            "target_lru_pn",
            F.col("slot.slot_name").alias("slot_name"),
            F.col("slot.allowed_pns").alias("allowed_pns"),
            F.lit("mandatory").alias("slot_type"),
            F.col("rule.context_check.part_type").alias("context_part_type"),
            F.col("rule.context_check.pn").alias("context_pn"),
            F.lit(None).cast(StringType()).alias("mix_policy"),
            F.lit(None).cast(StringType()).alias("group_name"),
            F.col("rule.comment").alias("rule_comment"),
            # Propagate rule-level metadata
            "amdt_name",
            "warning_text",
            "description",
            "supersedes",
        )
    else:
        # Create empty dataframe with same schema
        df_mandatory = (
            df.limit(0)
            .select("unit", "rule_id", "target_lru_pn", "amdt_name", "warning_text", "description", "supersedes")
            .withColumn("slot_name", F.lit(None).cast(StringType()))
            .withColumn("allowed_pns", F.array().cast(ArrayType(StringType())))
            .withColumn("slot_type", F.lit("mandatory"))
            .withColumn("context_part_type", F.lit(None).cast(StringType()))
            .withColumn("context_pn", F.lit(None).cast(StringType()))
            .withColumn("mix_policy", F.lit(None).cast(StringType()))
            .withColumn("group_name", F.lit(None).cast(StringType()))
            .withColumn("rule_comment", F.lit(None).cast(StringType()))
        )

    # ==========================================
    # PART 2: Handle slot_groups (for PSM_COM/PSM_MON, CPU_COM/CPU_MON, IO_CARDS_GROUP, etc.)
    # ==========================================
    df_groups = df.filter(F.col("rule.slot_groups").isNotNull())

    if df_groups.count() > 0:
        df_groups = df_groups.withColumn("slot_group", F.explode(F.col("rule.slot_groups")))
        df_groups = df_groups.withColumn("slot_name_exploded", F.explode(F.col("slot_group.slots_included")))

        df_groups = df_groups.select(
            "unit",
            "rule_id",
            "target_lru_pn",
            F.col("slot_name_exploded").alias("slot_name"),
            F.col("slot_group.allowed_pns").alias("allowed_pns"),
            F.lit("group").alias("slot_type"),
            F.col("rule.context_check.part_type").alias("context_part_type"),
            F.col("rule.context_check.pn").alias("context_pn"),
            F.col("slot_group.mix_policy").alias("mix_policy"),
            F.col("slot_group.group_name").alias("group_name"),
            F.col("rule.comment").alias("rule_comment"),
            # Propagate rule-level metadata
            "amdt_name",
            "warning_text",
            "description",
            "supersedes",
        )

        # Union both parts
        df_result = df_mandatory.union(df_groups)
    else:
        df_result = df_mandatory

    # ==========================================
    # v15.1 NORMALIZATION: Clean ALL spaces from slot/group names
    # Critical fix: "PSM _CARD" → "PSM_CARD"
    # ==========================================
    df_result = df_result.withColumn("slot_name", F.regexp_replace(F.col("slot_name"), r"\s+", ""))

    df_result = df_result.withColumn(
        "group_name",
        F.when(F.col("group_name").isNotNull(), F.regexp_replace(F.col("group_name"), r"\s+", "")).otherwise(
            F.col("group_name")
        ),
    )

    # Create composite key (after normalization)
    df_result = df_result.withColumn(
        "slot_rule_key",
        F.concat_ws("::", F.col("target_lru_pn"), F.col("rule_id"), F.col("slot_name")),
    )

    output.write_dataframe(df_result)

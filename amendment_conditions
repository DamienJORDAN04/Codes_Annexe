"""
Business Logic: Amendment Conditions Detail

Extracts detailed conditions for each amendment rule.
Shows exactly what cards are required in which slots for each rule.

This provides the "CONDITIONS" section in the UI.

v16.0: Removed description, supersedes, supersedes_count, amendment_priority —
       these fields no longer exist in rules_amendments or parsed_amendment_rules.
v16.1: Restored amdt_name, warning_text, description, supersedes from rules_amendments.
       BAC slot now naturally appears in required_slots_str for FCPC LA2K2 STD rules
       since it is a regular mandatory_slot in Logic_JSON.
v16.1.1: Defensive column aliasing — handles both 'amdt_name' (new) and 'amendment_name'
         (legacy) in rules_source so the transform builds even if rules_amendments
         has not yet been rebuilt.

Input: parsed_amendment_rules, rules_amendments
Output: /Airbus/EYY/Logic/Avionics/Support/Conf_Management/business_logic/amendment_conditions
"""

from pyspark.sql import functions as F
from pyspark.sql.types import StringType
from transforms.api import Input, Output, transform


@transform(
    output=Output("/Airbus/EYY/Logic/Avionics/Support/Conf_Management/business_logic/amendment_conditions"),
    parsed_rules=Input("/Airbus/EYY/Logic/Avionics/Support/Conf_Management/intermediate/parsed_amendment_rules"),
    rules_source=Input("/Airbus/EYY/Logic/Avionics/Support/Conf_Management/sources/rules_amendments"),
)
def compute(parsed_rules, rules_source, output):
    """
    Creates detailed condition descriptions for each rule.

    For each rule, extracts:
    - Which slots are mandatory (including BAC for FCPC LA2K2 STD rules)
    - Required conditions
    - Context dependencies (case_count)
    - amdt_name, warning_text, description, supersedes (from rules_amendments)
    """

    df_parsed = parsed_rules.dataframe()
    df_rules = rules_source.dataframe()

    # ==========================================
    # DEFENSIVE: normalise 'amendment_name' → 'amdt_name' if needed
    # The rules_amendments source may still expose the old column name if it
    # hasn't been rebuilt yet after the v16.1 rename.
    # ==========================================
    rules_cols = df_rules.columns
    if "amdt_name" not in rules_cols and "amendment_name" in rules_cols:
        df_rules = df_rules.withColumnRenamed("amendment_name", "amdt_name")

    for col_name in ("amdt_name", "warning_text", "description", "supersedes"):
        if col_name not in df_rules.columns:
            df_rules = df_rules.withColumn(col_name, F.lit(None).cast(StringType()))

    # Filter rows with valid slot data
    df_parsed_clean = df_parsed.filter(F.col("allowed_pns").isNotNull())

    # Aggregate per rule: one row per (target_lru_pn, rule_id)
    df_aggregated = df_parsed_clean.groupBy("target_lru_pn", "rule_id").agg(
        # Collect slot names for display
        F.collect_list("slot_name").alias("required_slots_list"),
        # Count slots
        F.countDistinct("slot_name").alias("slot_count"),
        # Count mandatory vs group slots
        F.sum(F.when(F.col("slot_type") == "mandatory", 1).otherwise(0)).alias("mandatory_slots_count"),
        # Context dependency count (number of distinct config cases)
        F.countDistinct(F.when(F.col("context_pn").isNotNull(), F.col("context_pn"))).alias("case_count"),
    )

    # Conditions summary sentence
    df_aggregated = df_aggregated.withColumn(
        "conditions_summary",
        F.when(
            F.col("case_count") > 1,
            F.concat(
                F.lit("This rule has "),
                F.col("case_count").cast(StringType()),
                F.lit(" configuration cases"),
            ),
        )
        .when(
            F.col("mandatory_slots_count") > 0,
            F.concat(
                F.lit("Requires "),
                F.col("mandatory_slots_count").cast(StringType()),
                F.lit(" mandatory slot(s)"),
            ),
        )
        .otherwise(F.lit("Standard configuration")),
    )

    # Join with rules source for metadata
    # Now includes: unit, amdt_name, warning_text, description, supersedes
    df_final = df_aggregated.join(
        df_rules.select(
            "target_lru_pn",
            "rule_id",
            "unit",
            "amdt_name",
            "warning_text",
            "description",
            "supersedes",
        ),
        on=["target_lru_pn", "rule_id"],
        how="inner",
    )

    # Format required slots as comma-separated string
    df_final = df_final.withColumn("required_slots_str", F.concat_ws(", ", F.col("required_slots_list")))

    # Create rule key
    df_final = df_final.withColumn(
        "rule_key",
        F.concat_ws("::", F.col("target_lru_pn"), F.col("rule_id")),
    )

    # Create formatted conditions text
    df_final = df_final.withColumn(
        "conditions_formatted",
        F.concat(
            F.lit("Required slots: "),
            F.col("required_slots_str"),
        ),
    )

    # Drop intermediate list column (only the string version is needed downstream)
    df_final = df_final.drop("required_slots_list")

    output.write_dataframe(df_final)

